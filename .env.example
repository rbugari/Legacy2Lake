# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 Configuration (Mandatory for Cloud-Native)
STORAGE_PROVIDER="R2" # Use "LOCAL" for local filesystem
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="legacy2lake"
R2_ACCOUNT_ID="your-account-id"

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-05-13"
AZURE_OPENAI_DEPLOYMENT_ID="gpt-4o"

# SMTP Configuration
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="user@domain.com"
SMTP_PASS="password"
SENDER_EMAIL="user@domain.com"
FRONTEND_URL="http://localhost:3000"

# Optional: OpenAI (for non-Azure providers)
OPENAI_API_KEY="your-openai-key"

# Optional: Anthropic
ANTHROPIC_API_KEY="your-anthropic-key"

# Optional: Google AI
GOOGLE_API_KEY="your-google-key"

# Backend Settings
DEBUG_MODE=false
SERVER_PORT=8085

# Frontend Settings (Vercel)
NEXT_PUBLIC_API_URL="https://your-backend.railway.app"
