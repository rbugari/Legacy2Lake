# ============================================
# Legacy2Lake v3.9 - Environment Variables
# ============================================
# 
# ⚠️ IMPORTANTE: 
# Este archivo muestra solo variables de INFRAESTRUCTURA.
# Las credenciales de LLM (OpenAI, Groq, Azure) y modelos
# están en la BASE DE DATOS (utm_provider_vault) por tenant.
#
# ============================================

# ============================================
# 1. SUPABASE (Base de datos) - REQUERIDO
# ============================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# 2. STORAGE (Cloudflare R2) - REQUERIDO
# ============================================
# Opciones: "R2" o "LOCAL"
STORAGE_PROVIDER="R2"

# Si STORAGE_PROVIDER=R2:
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="legacy2lake"
R2_ENDPOINT_URL="https://REPLACE_WITH_YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# Si STORAGE_PROVIDER=LOCAL (desarrollo):
# LOCAL_STORAGE_PATH="./storage"

# ============================================
# 3. EMAIL (SMTP) - OPCIONAL
# ============================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="user@domain.com"
SMTP_PASS="password"
SENDER_EMAIL="noreply@domain.com"
FRONTEND_URL="http://localhost:3000"

# ============================================
# 4. CONFIGURACIÓN DEL SERVIDOR - OPCIONAL
# ============================================
DEBUG_MODE=false
SERVER_PORT=8085

# Frontend (Next.js/Vercel)
NEXT_PUBLIC_API_URL="https://your-backend.railway.app"

# ============================================
# ❌ NO INCLUIR AQUÍ (v3.9+)
# ============================================
#
# Las siguientes variables YA NO van en .env, 
# están en la BASE DE DATOS por tenant:
#
# ❌ OPENAI_API_KEY          → utm_provider_vault (tabla DB)
# ❌ GROQ_API_KEY            → utm_provider_vault (tabla DB)
# ❌ AZURE_OPENAI_API_KEY    → utm_provider_vault (tabla DB)
# ❌ ANTHROPIC_API_KEY       → utm_provider_vault (tabla DB)
# ❌ GOOGLE_API_KEY          → utm_provider_vault (tabla DB)
# ❌ AZURE_OPENAI_ENDPOINT   → utm_provider_vault (tabla DB)
# ❌ AZURE_OPENAI_DEPLOYMENT → utm_provider_vault (tabla DB)
# ❌ DEFAULT_MODEL           → utm_model_catalog (tabla DB)
# ❌ MODEL_NAME              → utm_model_catalog (tabla DB)
#
# RAZÓN:
# - Cada TENANT tiene sus propias API keys
# - Cada TENANT paga por su propio uso
# - MANAGER configura proveedores vía UI/API
# - No hay credenciales compartidas entre tenants
# - Aislamiento completo entre clientes
#
# CONFIGURACIÓN:
# 1. Login como MANAGER del tenant
# 2. Ir a Settings → Provider Vault
# 3. Agregar API keys (OpenAI, Groq, Azure, etc.)
# 4. Seleccionar modelos disponibles
#
# ============================================

# ============================================
# MIGRACIÓN DESDE VERSIONES ANTERIORES
# ============================================
#
# Si vienes de v3.8 o anterior:
# 1. Elimina TODAS las variables *_API_KEY de .env
# 2. Cada tenant debe configurar sus propias keys
# 3. MANAGER usa la UI para agregar proveedores
# 4. Las keys se almacenan en utm_provider_vault
#
# Ejemplo de migración:
#   Antes: OPENAI_API_KEY en .env (compartido)
#   Ahora: Cada tenant su propia key en utm_provider_vault
#
# ============================================

